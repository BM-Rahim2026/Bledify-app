# Copy to .env.local for local development. On Vercel, connecting the Supabase
# integration (Storage → Supabase) sets the Supabase values automatically.

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection, used by `npm run migrate` / the build
POSTGRES_URL_NON_POOLING=

# Public site address used in shop links and emails, e.g. https://bledify.dz
NEXT_PUBLIC_SITE_URL=

# AI assistant for sellers (Claude). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: new-order email alerts through Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM="Bledify <commandes@your-domain>"

# Online payments (Chargily Pay: CIB / Edahabia). Secret key from pay.chargily.com → Developers corner.
# Test keys work with test cards; set CHARGILY_MODE=live with a live key to take real payments.
# Webhook URL to register at Chargily: https://<your-site>/api/payments/chargily/webhook
CHARGILY_SECRET_KEY=
CHARGILY_MODE=test
# Local development only: simulated payment page instead of Chargily (ignored in production)
PAYMENTS_FAKE=

# Daily email digest (Vercel Cron sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=
